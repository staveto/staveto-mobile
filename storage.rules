rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function signedIn() {
      return request.auth != null;
    }
    
    function uid() {
      return request.auth.uid;
    }

    function projectData(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
    }
    
    // Project owner check - same as Firestore rules
    function projectOwner(projectId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && projectData(projectId).ownerId == uid();
    }
    
    // Project member: membersByUid exists OR legacy members/{uid} with status active
    function isProjectMember(projectId) {
      return signedIn()
        && (
          firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid()))
          || (
            firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(uid()))
            && (
              !("status" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data)
              || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.status == "active"
            )
          )
        );
    }

    function isAssignedOnProject(projectId) {
      let data = projectData(projectId);
      return signedIn()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && (
          ("assignedMemberIds" in data && uid() in data.assignedMemberIds)
          || ("assignedUserIds" in data && uid() in data.assignedUserIds)
          || (
            firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(uid()))
            && (
              !("status" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data)
              || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.status == "active"
            )
          )
        );
    }

    function editorInMembersByUid(projectId) {
      return firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid()))
        && (
          firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.permissionLevel == 'editor'
          || firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.permissionLevel == 'admin'
        );
    }

    function editorInLegacyMembers(projectId) {
      return firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(uid()))
        && (
          !("status" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data)
          || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.status == "active"
        )
        && (
          firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.permissionLevel == 'editor'
          || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.permissionLevel == 'admin'
        );
    }

    // Matches Firestore canWriteAsEditor for attachment uploads
    function canWriteAsEditor(projectId) {
      return projectOwner(projectId)
        || editorInMembersByUid(projectId)
        || (
          isProjectMember(projectId)
          && !firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid()))
          && editorInLegacyMembers(projectId)
        )
        || isAssignedOnProject(projectId);
    }

    // Field crew with diary access may add site photos (Firestore attachments create rule)
    function canReadDiary(projectId) {
      return projectOwner(projectId)
        || isAssignedOnProject(projectId)
        || (
          firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid()))
          && (
            !("sharedItems" in firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data)
            || !(firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems is map)
            || !("diary" in firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems)
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems.diary != false
          )
        )
        || (
          firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(uid()))
          && (
            !("status" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data)
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.status == "active"
          )
          && (
            !("sharedItems" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data)
            || !(firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.sharedItems is map)
            || !("diary" in firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.sharedItems)
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(uid())).data.sharedItems.diary != false
          )
        );
    }
    
    // Read attachments: owner OR member with tasks/expenses/documents permission (matches Firestore)
    function canReadAttachments(projectId) {
      return projectOwner(projectId)
        || (
          isProjectMember(projectId)
          && (
            !firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid()))
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems.tasks == true
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems.expenses == true
            || firestore.get(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())).data.sharedItems.documents == true
          )
        )
        || isAssignedOnProject(projectId)
        || canReadDiary(projectId);
    }
    
    // Write attachments: align with Firestore — editors, assigned crew, diary-enabled field workers
    function canWriteAttachments(projectId) {
      return canWriteAsEditor(projectId) || canReadDiary(projectId);
    }
    
    // Unified attachments: projects/{projectId}/attachments/{attachmentId}/{filename}
    match /projects/{projectId}/attachments/{attachmentId}/{filename} {
      allow read: if canReadAttachments(projectId);
      allow write: if canWriteAttachments(projectId)
        && request.resource.size < 50 * 1024 * 1024;
    }
    
    // DEPRECATED: Task attachments nested path (backward compatibility)
    match /projects/{projectId}/tasks/{taskId}/attachments/{attachmentId}/{filename} {
      allow read: if canReadAttachments(projectId);
      allow write: if canWriteAttachments(projectId)
        && request.resource.size < 50 * 1024 * 1024;
    }
    
    // Problem photos: projects/{projectId}/problems/{problemId}/{filename}
    // Firestore allows create for editors OR any project member
    match /projects/{projectId}/problems/{problemId}/{filename} {
      allow read: if projectOwner(projectId) || isProjectMember(projectId) || isAssignedOnProject(projectId);
      allow write: if (canWriteAttachments(projectId) || isProjectMember(projectId) || isAssignedOnProject(projectId))
        && request.resource.size < 15 * 1024 * 1024;
    }
    
    // Equipment photos (MAINTENANCE): projects/{projectId}/equipment/{equipmentId}/photo_*.jpg|png
    match /projects/{projectId}/equipment/{equipmentId}/{filename} {
      allow read: if projectOwner(projectId);
      
      allow write: if projectOwner(projectId)
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB per photo
    }
    
    // Project cover photo: projects/{projectId}/cover/{filename}
    match /projects/{projectId}/cover/{filename} {
      allow read: if signedIn()
        && (projectOwner(projectId)
          || firestore.exists(/databases/(default)/documents/projects/$(projectId)/membersByUid/$(uid())));
      allow write: if projectOwner(projectId)
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB
    }
    
    // User-owned equipment photos (tab Equipment, not project subcollection)
    match /users/{userId}/equipment/{equipmentId}/{fileName} {
      allow read: if signedIn() && uid() == userId;
      allow write: if signedIn() && uid() == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    function isOrgOwner(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.ownerUid == uid();
    }

    function isOrgMemberActive(orgId) {
      return signedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(uid()))
            && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(uid())).data.status == 'active'
          )
          || isOrgOwner(orgId)
        );
    }

    function isOrgChatWriter(orgId) {
      return isOrgMemberActive(orgId)
        && (
          isOrgOwner(orgId)
          || firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(uid())).data.role in ['owner', 'admin', 'manager', 'worker']
        );
    }

    // Business team chat images
    match /organizations/{orgId}/chats/{chatId}/messages/{fileName} {
      allow read: if isOrgMemberActive(orgId);
      allow write: if isOrgChatWriter(orgId)
        && request.resource.size < 15 * 1024 * 1024;
    }

    // User profile photos
    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn() && uid() == userId;
      allow write: if signedIn() && uid() == userId
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB
    }

    // AI project draft documents (uploaded before project exists, for AI context)
    match /users/{userId}/aiProjectDrafts/{draftId}/documents/{fileName} {
      allow read: if signedIn() && uid() == userId;
      allow write: if signedIn() && uid() == userId
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn() && uid() == userId;
    }

    // Staveto Office AI wizard — workspace-scoped draft uploads (before project exists)
    match /workspaces/{workspaceId}/ai-drafts/{sessionId}/{fileName} {
      allow read: if signedIn() && (
        uid() == workspaceId
        || isOrgMemberActive(workspaceId)
      );
      allow write: if signedIn()
        && (
          uid() == workspaceId
          || isOrgMemberActive(workspaceId)
        )
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn()
        && (
          uid() == workspaceId
          || isOrgMemberActive(workspaceId)
        );
    }

    // Deny all other paths (must come after specific matches)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
